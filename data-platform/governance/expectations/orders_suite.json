{
  "expectation_suite_name": "orders_cdc_suite",
  "meta": {
    "notes": "Applied to each Spark micro-batch of pg.public.orders CDC events after transform, before ClickHouse write. Failures route to orders_dlq."
  },
  "expectations": [
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "id"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "id"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "customer_id"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "product_id"}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "quantity",
        "min_value": 1,
        "max_value": 100000,
        "mostly": 0.99,
        "meta": {"why": "Positive quantity; NULL on op=d excluded via mostly"}
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "_version"}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "_version",
        "min_value": 1577836800000,
        "max_value": 4102444800000
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {"column": "_deleted", "value_set": [0, 1]}
    }
  ]
}
