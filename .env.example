# PostgreSQL
POSTGRES_IMAGE_TAG=15-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# Kafka
KAFKA_IMAGE_TAG=7.8.2
ZOOKEEPER_IMAGE_TAG=7.8.2
REDPANDA_CONSOLE_IMAGE_TAG=v2.8.7

# Debezium
DEBEZIUM_IMAGE_TAG=2.7.3.Final
DEBEZIUM_UI_IMAGE_TAG=1.9

# Spark
SPARK_IMAGE_TAG=3.5.3
JUPYTER_SPARK_TAG=x86_64-spark-3.5.0

# Analytics
CLICKHOUSE_VERSION=23.8-alpine
CLICKHOUSE_DB=ecommerce_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123

GRAFANA_VERSION=10.3.12
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_CLICKHOUSE_PLUGIN_VERSION=4.8.2

# Governance (Phase 2 — PII / RBAC)
# Salt for deterministic SHA-256 hashing of PII columns (customers.email,
# customers.name). Rotating this value invalidates historical hashes — see
# data-platform/governance/pii/salt-rotation.md before changing.
PII_SALT=change-me-before-first-run
# Password for the ClickHouse analyst_readonly role that Grafana connects as.
CLICKHOUSE_ANALYST_PASSWORD=analyst_readonly_change_me
# Observability (Phase 3 alerts). Grafana Unified Alerting REQUIRES a
# non-empty URL for provisioning to succeed. The noop default below fails
# delivery cleanly and keeps alerts visible in the Grafana UI. Override
# with a real webhook.site URL to receive external notifications.
OBS_ALERT_WEBHOOK_URL=http://127.0.0.1:9999/noop
# Optional: Slack incoming webhook (https://api.slack.com/messaging/webhooks)
OBS_SLACK_WEBHOOK_URL=http://127.0.0.1:9999/noop

# DLQ topic retention overrides. Defaults (7 days / 100 MB per topic) are
# applied by scripts/setup_dlq_topics.sh on every `make up` and drift-correct
# any manual `kafka-configs --alter` back to these values on next boot. Set
# these here (persistent) or on-the-fly (`DLQ_RETENTION_MS=... make apply-dlq-topics`)
# to raise retention temporarily for post-incident forensics.
#DLQ_RETENTION_MS=604800000
#DLQ_RETENTION_BYTES=104857600

# GX Data Docs second-pass validation (opt-in). Set to 1 alongside
# ENABLE_GX_GATE=1 to enable the real Great Expectations engine as a
# reporter (Data Docs site + Prometheus metrics). Requires the `gx-docs`
# extra: `uv sync --extra gx-docs`. See docs/observability.md.
#ENABLE_GX_DATA_DOCS=1

# OpenMetadata ingestion JWT. Consumed by the ingestion CLI (make ingest-pg /
# ingest-kafka / ingest-clickhouse / ingest-all / ingest-status) via ${OM_INGESTION_JWT}
# expansion inside data-platform/governance/openmetadata/ingestion/*.yaml.
# OM 1.5.9 signs JWTs with per-install RSA keys — no well-known default; the
# operator retrieves the long-lived bot token once from OM Settings → Bots →
# ingestion-bot → Revoke/Regenerate JWT Token → copy. See docs/governance.md
# ("Obtain the ingestion JWT") for the CLI-based alternative.
#OM_INGESTION_JWT=paste-ingestion-bot-jwt-here
